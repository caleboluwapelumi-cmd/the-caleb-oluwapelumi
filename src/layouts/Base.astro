---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo, { type Props as SeoProps } from '../components/seo/Seo.astro';
import { site } from '../data/site';

export interface Props extends SeoProps {}

const seo = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · Insights`} href="/rss.xml" />
    <Seo {...seo} />
    <ClientRouter />
    {/* Without JS the menu toggle can't open anything, so small screens fall
        back to the inline nav and CTA, wrapping under the wordmark. */}
    <noscript>
      <style>
        [data-menu-toggle] { display: none !important; }
        [data-primary-nav] { display: block !important; }
        [data-header-cta] { display: flex !important; }
        [data-site-header] { position: relative !important; }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link" data-skip-link>Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  /*
   * GSAP and Lenis are loaded on demand, never statically. A visitor with
   * reduced motion on downloads neither: the check happens before the import,
   * so the cost of the motion layer is only paid by pages that will use it.
   *
   * Every listener is re-attached on astro:page-load, and everything the
   * module built is killed on astro:before-swap — view transitions replace the
   * document, and a ScrollTrigger left on a detached node stops working after
   * the first client-side navigation.
   */
  const REDUCE = '(prefers-reduced-motion: reduce)';
  let loaded = false;

  async function startMotion() {
    if (window.matchMedia(REDUCE).matches) return;
    const { initMotion } = await import('../lib/motion');
    loaded = true;
    initMotion();
  }

  async function stopMotion() {
    // Nothing to tear down until the module has actually run once. Checking
    // the media query here would be wrong: the case that needs teardown most
    // is the user turning reduced motion *on* mid-session.
    if (!loaded) return;
    const { teardownMotion } = await import('../lib/motion');
    teardownMotion();
  }

  document.addEventListener('astro:page-load', startMotion);
  document.addEventListener('astro:before-swap', stopMotion);

  // Switching the OS setting on mid-session tears the motion layer down;
  // switching it off loads and starts it.
  window.matchMedia(REDUCE).addEventListener('change', (event) => {
    if (event.matches) void stopMotion();
    else void startMotion();
  });
</script>

<style is:global>
  /* Keeps anchor targets, including the skip link's, clear of the sticky header. */
  html {
    scroll-padding-top: 5rem;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  #main {
    flex: 1;
  }
</style>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    background-color: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
