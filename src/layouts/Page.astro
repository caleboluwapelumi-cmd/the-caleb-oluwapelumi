---
import Base from './Base.astro';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Visible <h1>. Defaults to `title`. */
  heading?: string;
}

const { title, description, noindex, heading = title } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <article class="page">
    <header class="page-header">
      <h1>{heading}</h1>
      <slot name="lede" />
    </header>
    <div class="page-body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .page {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: 3rem 1.25rem 6rem;
  }

  .page-header {
    max-width: 68ch;
    margin-bottom: 3rem;
  }

  .page-header :global(p) {
    margin-top: 1.25rem;
    color: var(--color-ink-body);
  }
</style>
