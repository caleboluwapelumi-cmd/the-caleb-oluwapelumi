---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Tag from '../components/ui/Tag.astro';
import Reveal from '../components/ui/Reveal.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { workCategoryLabels } from '../data/taxonomy';
import { site } from '../data/site';
import { creativeWorkSchema } from '../lib/jsonld';
import { workHref, type WorkEntry } from '../lib/collections';
import { ogImagePath } from '../lib/og';

export interface Props {
  entry: WorkEntry;
  prev?: WorkEntry;
  next?: WorkEntry;
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const path = workHref(entry);
const client = data.client ?? data.clientDescriptor;
const siteUrl = Astro.site ?? Astro.url;
---

<Base
  title={data.title}
  description={data.summary}
  image={ogImagePath(path)}
  imageAlt={`${data.title} — ${site.name}`}
  jsonLd={[
    creativeWorkSchema(siteUrl, {
      path,
      title: data.title,
      summary: data.summary,
      year: data.year,
      client,
      services: data.services,
    }),
  ]}
>
  <article>
    <header class="shell hero">
      <p class="eyebrow">
        <a href={`/work?category=${data.category}`} class="category">
          {workCategoryLabels[data.category]}
        </a>
      </p>
      <h1>{data.title}</h1>
      <p class="summary measure">{data.summary}</p>

      <dl class="meta">
        {
          client && (
            <div>
              <dt>Client</dt>
              <dd>{client}</dd>
            </div>
          )
        }
        <div>
          <dt>Year</dt>
          <dd>{data.year}</dd>
        </div>
        {
          data.services.length > 0 && (
            <div class="meta-services">
              <dt>Services</dt>
              <dd>
                <ul role="list" class="chips">
                  {data.services.map((service) => (
                    <li>
                      <Tag>{service}</Tag>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="shell">
      {/* The cover is a fixed-ratio mask and the image inside it is taller than
          the frame, so the parallax has somewhere to travel. Unmasked, the
          drift would tear a gap open along the top edge. The overhang is 20% of
          the image against a drift capped at 12%, so the frame can never run
          out of image at any viewport width. */}
      <div class="cover">
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 72rem) 69.5rem, calc(100vw - 2.5rem)"
          loading="eager"
          fetchpriority="high"
          data-parallax="0.12"
        />
      </div>
    </div>

    {/* Skipped entirely when there are no outcomes, rather than an empty shell. */}
    {
      data.outcomes.length > 0 && (
        <section class="shell outcomes" aria-labelledby="outcomes-title">
          <h2 id="outcomes-title" class="eyebrow">Outcomes</h2>
          <Reveal as="div" stagger class="outcome-list">
            {data.outcomes.map((outcome) => (
              <dl class="outcome">
                <dt>{outcome.label}</dt>
                <dd>{outcome.value}</dd>
              </dl>
            ))}
          </Reveal>
        </section>
      )
    }

    <div class="shell body">
      <div class="prose">
        <slot />
      </div>
      {
        data.liveUrl && (
          <p class="live">
            <a href={data.liveUrl} rel="noopener">
              Visit live site<span class="sr-only"> (opens external site)</span>
            </a>
          </p>
        )
      }
    </div>

    {
      data.gallery.length > 0 && (
        <section class="shell gallery" aria-labelledby="gallery-title">
          <h2 id="gallery-title" class="sr-only">Gallery</h2>
          <Reveal as="div" stagger class="gallery-grid">
            {data.gallery.map((item) => (
              <figure>
                <Image
                  src={item.src}
                  alt={item.alt}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 48rem) 34rem, calc(100vw - 2.5rem)"
                  loading="lazy"
                />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </Reveal>
        </section>
      )
    }

    {
      (prev || next) && (
        <nav class="shell pager" aria-label="More case studies">
          {prev && (
            <a href={workHref(prev)} rel="prev" class="pager-link">
              <span class="eyebrow">Previous project</span>
              <span class="pager-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a href={workHref(next)} rel="next" class="pager-link pager-link--next">
              <span class="eyebrow">Next project</span>
              <span class="pager-title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <CtaBand id="work-cta" />
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem) 2.5rem;
  }

  .category {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
  }

  h1 {
    margin-top: 0.5rem;
    max-width: 22ch;
  }

  .summary {
    margin-top: 1.25rem;
    font-size: var(--text-h3);
    line-height: 1.4;
    color: var(--color-ink-body);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }

  .meta dt {
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .meta dd {
    margin-top: 0.25rem;
    color: var(--color-ink);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: var(--color-paper-alt);
  }

  .cover :global(img) {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center top;
  }

  .outcomes {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .outcome-list {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (width >= 40rem) {
    .outcome-list {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  .outcome {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    padding: 1.5rem;
    border-top: 3px solid var(--color-accent);
    background-color: var(--color-paper-alt);
  }

  .outcome dd {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1.1;
    color: var(--color-ink);
  }

  .body {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .live {
    margin-top: 2rem;
  }

  .live a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .gallery {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .gallery-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (width >= 48rem) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .gallery :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .pager {
    display: grid;
    gap: 1rem;
    margin-block: clamp(4rem, 3rem + 3vw, 6rem);
  }

  @media (width >= 40rem) {
    .pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-height: 2.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink);
    text-decoration-line: none;
    transition: border-color var(--dur-fast) var(--ease-out-expo);
  }

  .pager-link--next {
    grid-column: -2;
    text-align: end;
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.25;
  }

  @media (hover: hover) {
    .pager-link:hover {
      border-top-color: var(--color-accent);
    }
    .pager-link:hover .pager-title {
      text-decoration-line: underline;
    }
  }
</style>
