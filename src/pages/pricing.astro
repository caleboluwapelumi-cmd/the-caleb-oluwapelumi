---
import Page from '../layouts/Page.astro';
import Button from '../components/ui/Button.astro';
import Reveal from '../components/ui/Reveal.astro';
import { pricing, formatAmount, PRICING_NOTE } from '../data/pricing';
import { getService } from '../data/services';
---

{/* TODO(copy): meta description for the pricing page. */}
<Page title="Pricing" description="TODO(copy): pricing page meta description">
  <Fragment slot="lede">
    <p>
      Every project is different, so pricing depends on scope, complexity, and requirements. These
      packages are a starting point.
    </p>
    <p class="note">{PRICING_NOTE}</p>
  </Fragment>

  <div class="pricing">
    {
      pricing.map(({ service: slug, tiers }) => {
        const service = getService(slug);
        return (
          <section id={slug} class="service" aria-labelledby={`${slug}-title`}>
            <h2 id={`${slug}-title`}>{service.name}</h2>
            <Reveal as="ul" stagger class="tiers" role="list">
              {tiers.map((tier) => (
                <li class="tier">
                  <h3>{tier.name}</h3>
                  <p class="price">
                    {tier.from && <span class="from">From</span>}
                    <span class="amount">{formatAmount(tier.usd)}</span>
                  </p>
                  <p class="who">{tier.whoItsFor}</p>
                  <ul class="includes">
                    {tier.includes.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <p class="turnaround">
                    {/* TODO(copy): turnaround label. */}
                    <span class="eyebrow">Turnaround</span> {tier.turnaround}
                  </p>
                  <div class="tier-cta">
                    {/* TODO(copy): CTA label. */}
                    <Button href={`/contact?service=${slug}`} variant="secondary">
                      Enquire<span class="sr-only"> about {service.name}: {tier.name}</span>
                    </Button>
                  </div>
                </li>
              ))}
            </Reveal>
          </section>
        );
      })
    }

    {/* Consultation-led offers (strategy, positioning) have no price card; they route here. */}
    <section class="unsure" aria-labelledby="unsure-title">
      <Reveal class="unsure-card">
        {/* TODO(copy): "Not sure what you need?" card body and CTA label. */}
        <h2 id="unsure-title">Not sure what you need?</h2>
        <p class="measure">TODO(copy): route strategy and positioning enquiries to a booked session</p>
        <div class="tier-cta">
          <Button href="/contact#book" variant="primary">Book a Strategy Session</Button>
        </div>
      </Reveal>
    </section>
  </div>
</Page>

<style>
  /* Sits on paper, so accent-ink rather than bare accent. */
  .note {
    color: var(--color-accent-ink);
  }

  .service + .service {
    margin-top: clamp(3.5rem, 3rem + 2vw, 5rem);
  }

  .service h2 {
    margin-bottom: 1.5rem;
  }

  .tiers {
    display: grid;
    gap: 1rem;
  }

  @media (width >= 48rem) {
    .tiers {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    background-color: var(--color-paper);
  }

  .price {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .from {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .amount {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.2;
    color: var(--color-ink);
  }

  .includes {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .includes li + li {
    margin-top: 0.375rem;
  }

  .includes li::marker {
    color: var(--color-accent-ink);
  }

  .turnaround {
    font-size: var(--text-small);
  }

  .turnaround .eyebrow {
    margin-right: 0.25rem;
  }

  .tier-cta {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .unsure {
    margin-top: clamp(3.5rem, 3rem + 2vw, 5rem);
  }

  .unsure-card {
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    border: 1px solid var(--color-accent);
    border-radius: 0.5rem;
    background-color: var(--color-accent-wash);
  }

  .unsure-card p {
    margin-top: 1rem;
  }

  .unsure-card .tier-cta {
    margin-top: 1.5rem;
  }
</style>
