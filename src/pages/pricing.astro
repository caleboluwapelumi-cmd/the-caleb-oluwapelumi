---
import Page from '../layouts/Page.astro';
import Button from '../components/ui/Button.astro';
import Reveal from '../components/ui/Reveal.astro';
import {
  pricing,
  formatAmount,
  PRICING_CLOSING,
  PRICING_PLACEHOLDER_NOTE,
} from '../data/pricing';
import { getService } from '../data/services';
import Icon from '../components/ui/Icon.astro';
import { tierIcon } from '../lib/service-icons';
---

<Page
  title="Pricing"
  description="Starting prices for web development, video editing, paid advertising, consultation, and digital solutions."
>
  <p slot="lede">
    Every project is different, so pricing depends on scope, complexity, and requirements. These
    packages are a starting point.
  </p>

  <div class="pricing">
    {
      pricing.map(({ service: slug, tiers, note }) => {
        const service = getService(slug);
        return (
          <section id={slug} class="service" aria-labelledby={`${slug}-title`}>
            <h2 id={`${slug}-title`}>{service.name}</h2>
            <Reveal as="ul" stagger class="tiers" role="list">
              {tiers.map((tier, i) => (
                <li class="tier">
                  <div class="tier-head">
                    <Icon
                      name={tierIcon(
                        tier.usd === 'custom',
                        tiers.slice(0, i).filter((t) => t.usd !== 'custom').length,
                      )}
                      size={20}
                    />
                    <h3>{tier.name}</h3>
                  </div>
                  <p class="price">
                    {tier.from && <span class="from">From</span>}
                    <span class="amount">{formatAmount(tier.usd)}</span>
                  </p>
                  {tier.detail && <p class="detail">{tier.detail}</p>}
                  <div class="tier-cta">
                    <Button href={`/contact?service=${slug}`} variant="secondary">
                      Get a Quote<span class="sr-only"> for {service.name}: {tier.name}</span>
                    </Button>
                  </div>
                </li>
              ))}
            </Reveal>
            {note && <p class="note">{note}</p>}
          </section>
        );
      })
    }

    <p class="placeholder-note">{PRICING_PLACEHOLDER_NOTE}</p>
    <p class="closing">{PRICING_CLOSING}</p>

    {/* Strategy, positioning and content strategy have no price card — they route here. */}
    <section class="unsure" aria-labelledby="unsure-title">
      <Reveal class="unsure-card">
        <h2 id="unsure-title">Not sure what you need?</h2>
        <p class="measure">
          Tell me what you’re trying to build or solve, and we’ll figure out the right scope
          together.
        </p>
        <div class="tier-cta">
          <Button href="/contact#book" variant="primary">Book a Strategy Session</Button>
        </div>
      </Reveal>
    </section>
  </div>
</Page>

<style>
  .service + .service {
    margin-top: clamp(3.5rem, 3rem + 2vw, 5rem);
  }

  .service h2 {
    margin-bottom: 1.5rem;
  }

  .tiers {
    display: grid;
    gap: 1rem;
  }

  @media (width >= 48rem) {
    .tiers {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    background-color: var(--color-paper);
    transition:
      background-color var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast) var(--ease-out-expo),
      transform var(--dur-base) var(--ease-out-expo);
  }

  /* Tier header: the icon is a scale marker, not a bullet — it repeats the
     ranking the tier names already carry, so it is decorative and hidden. */
  .tier-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-accent-ink);
  }

  .tier-head h3 {
    color: var(--color-ink);
  }

  .tier:focus-within {
    border-color: var(--color-ink);
    transform: translateY(-4px);
  }

  @media (hover: hover) {
    .tier:hover {
      border-color: var(--color-ink);
      transform: translateY(-4px);
    }
  }

  @supports (backdrop-filter: blur(1px)) {
    .tier:focus-within {
      background-color: color-mix(
        in srgb,
        var(--color-paper) var(--glass-opacity),
        transparent
      );
      backdrop-filter: blur(var(--glass-blur)) saturate(1.2);
    }

    @media (hover: hover) {
      .tier:hover {
        background-color: color-mix(
          in srgb,
          var(--color-paper) var(--glass-opacity),
          transparent
        );
        backdrop-filter: blur(var(--glass-blur)) saturate(1.2);
      }
    }
  }

  /* The blur is static and can stay; the lift is motion and cannot. */
  @media (prefers-reduced-motion: reduce) {
    .tier:focus-within,
    .tier:hover {
      transform: none;
    }
  }

  .price {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .from {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .amount {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.2;
    color: var(--color-ink);
  }

  .detail {
    font-size: var(--text-small);
    color: var(--color-ink-body);
  }

  .tier-cta {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* Sits on paper, so accent-ink rather than bare accent. */
  .note {
    margin-top: 1rem;
    padding-left: 0.875rem;
    border-left: 3px solid var(--color-accent);
    font-size: var(--text-small);
    color: var(--color-accent-ink);
  }

  .placeholder-note {
    max-width: 68ch;
    margin-top: clamp(3rem, 2.5rem + 2vw, 4rem);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .closing {
    max-width: 68ch;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.25;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .unsure {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4rem);
  }

  .unsure-card {
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    border: 1px solid var(--color-accent);
    border-radius: 0.5rem;
    background-color: var(--color-accent-wash);
  }

  .unsure-card p {
    margin-top: 1rem;
  }

  .unsure-card .tier-cta {
    margin-top: 1.5rem;
  }
</style>
