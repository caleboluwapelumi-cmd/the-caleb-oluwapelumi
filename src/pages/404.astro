---
import Page from '../layouts/Page.astro';
import Button from '../components/ui/Button.astro';
---

<Page title="Page not found" noindex>
  <p slot="lede">That page doesn’t exist — try one of these instead.</p>
  <div class="actions">
    <Button href="/work" variant="primary">Work</Button>
    <Button href="/services" variant="secondary">Services</Button>
    <Button href="/contact" variant="ghost">Contact</Button>
  </div>
</Page>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
