---
import Page from '../../layouts/Page.astro';
import InsightCard from '../../components/ui/InsightCard.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import Button from '../../components/ui/Button.astro';
import { getPublishedInsights, toInsightCard } from '../../lib/collections';
import { insightTags, insightTagLabels } from '../../data/taxonomy';

const entries = await getPublishedInsights();
const present = new Set(entries.flatMap((e) => e.data.tags));
const options = insightTags
  .filter((t) => present.has(t))
  .map((t) => ({ value: t, label: insightTagLabels[t] }));
---

<Page
  title="Insights"
  description="Practical thoughts on marketing, digital strategy, and business growth — lessons from actually building things."
>
  <Fragment slot="lede">
    <p>
      Practical thoughts on marketing, digital strategy, and business growth — lessons from building
      things, not theory.
    </p>
    <p>
      <a href="/rss.xml">Subscribe via RSS</a>
    </p>
  </Fragment>

  {
    entries.length > 0 ? (
      <div data-filter-root data-filter-param="tag">
        {/* Parallel to /work's "Filter by category", on this page's axis. */}
        {options.length > 1 && <FilterBar label="Filter by tag" options={options} />}
        <ul class="list" role="list">
          {entries.map((entry) => (
            <li data-filter-values={entry.data.tags.join(' ')}>
              <InsightCard {...toInsightCard(entry, 'h2')} />
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="empty">
        {/* Shown until the first post is published. */}
        <p class="measure">New insights are on the way — check back soon.</p>
        <Button href="/contact" variant="secondary">Get in touch</Button>
      </div>
    )
  }
</Page>

<style>
  .list {
    display: grid;
    gap: 2.5rem;
    max-width: 68ch;
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
</style>
