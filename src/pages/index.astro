---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import ProofBand from '../components/sections/ProofBand.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import WhyCaleb from '../components/sections/WhyCaleb.astro';
import WorkPreview from '../components/sections/WorkPreview.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import InsightsPreview from '../components/sections/InsightsPreview.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import {
  getPublishedInsights,
  getPublishedWork,
  toInsightCard,
  toWorkCard,
} from '../lib/collections';

const featuredWork = (await getPublishedWork())
  .filter((entry) => entry.data.featured)
  .slice(0, 3)
  .map((entry) => toWorkCard(entry));
const latestInsights = (await getPublishedInsights()).slice(0, 3).map((entry) => toInsightCard(entry));
---

<Base fullTitle="Caleb Oluwapelumi | Web Development, Video Editing & Paid Advertising">
  <Hero />
  <ProofBand />
  <ServicesGrid />
  <WhyCaleb />
  <WorkPreview items={featuredWork} />
  <ProcessSteps />
  <InsightsPreview items={latestInsights} />
  <CtaBand />
</Base>
