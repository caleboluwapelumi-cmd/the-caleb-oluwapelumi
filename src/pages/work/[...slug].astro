---
import { render } from 'astro:content';
import WorkEntryLayout from '../../layouts/WorkEntry.astro';
import { getPublishedWork } from '../../lib/collections';

export async function getStaticPaths() {
  const entries = await getPublishedWork();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1], next: entries[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<WorkEntryLayout entry={entry} prev={prev} next={next}>
  <Content />
</WorkEntryLayout>
