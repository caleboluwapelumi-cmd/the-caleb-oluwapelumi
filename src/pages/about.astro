---
import Page from '../layouts/Page.astro';
import Rule from '../components/ui/Rule.astro';
import Reveal from '../components/ui/Reveal.astro';
import Button from '../components/ui/Button.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { site } from '../data/site';

/*
 * Copy is transferred verbatim from the brief, not paraphrased, so the voice
 * survives. The three beats below are the brief's own closing line.
 */
const throughLine = ['Strategy.', 'Execution.', 'Results.'];

// Card titles and bodies come from the brief, verbatim.
const whatIBring = [
  {
    title: 'Technical Thinking',
    body: 'I understand how digital tools and technology can be applied to real business problems.',
  },
  {
    title: 'Creative Execution',
    body: 'I turn ideas, footage, campaigns, and concepts into usable digital content and experiences.',
  },
  {
    title: 'Business Understanding',
    body: 'I don’t build or create in isolation. I consider the business objective behind the work.',
  },
  {
    title: 'Problem Solving',
    body: 'Every project starts with a problem or opportunity. My job is to help find the practical solution.',
  },
];
---

<Page
  title="About"
  description="Caleb Oluwapelumi is a digital solutions specialist working across web development, video editing, and paid advertising for businesses everywhere."
>
  <p slot="lede">
    I’m Caleb Oluwapelumi. I work across technology, digital media, marketing, and business
    solutions, helping businesses turn ideas and problems into practical digital execution. I’m
    based in Lagos, Nigeria — but the work travels. I work with businesses wherever they are.
  </p>

  <div class="about">
    {/* No section heading here on purpose: this is the lede continuing, and the
        brief supplies no heading to put above it. */}
    <Reveal class="prose">
      <p>
        My work sits at the intersection of technology, creativity, and business. I build websites.
        I edit videos. I run paid campaigns. I develop digital solutions. I help businesses think
        through marketing and growth problems. What connects all of it is problem solving.
      </p>
      <p>
        I don’t believe businesses always need more complexity. They need the right solution for the
        problem in front of them. That’s how I approach my work: understand the objective, identify
        what is needed, build it properly, and improve it where necessary.
      </p>
    </Reveal>

    <Rule accent />

    {/* The strongest line in the brief. Display type, full page measure, and a
        list so the three beats keep their order without JS or decoration. */}
    <section class="through-line" aria-labelledby="about-through-line">
      <Reveal>
        <h2 id="about-through-line" class="eyebrow">The common thread</h2>
        <ol class="beats" role="list">
          {
            throughLine.map((beat, i) => (
              <li>
                <span class="beat-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="beat-text">{beat}</span>
              </li>
            ))
          }
        </ol>
      </Reveal>
    </section>

    <Rule />

    <section class="bring" aria-labelledby="about-bring">
      <Reveal>
        <h2 id="about-bring">What I Bring</h2>
        <ul class="bring-grid" role="list">
          {
            whatIBring.map((item) => (
              <li class="bring-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="actions">
          <Button href="/work" variant="primary">See the work</Button>
          <Button href="/services" variant="ghost">What I do</Button>
        </div>
      </Reveal>
    </section>

    <Rule />

    <section class="elsewhere" aria-labelledby="about-elsewhere">
      <Reveal>
        <h2 id="about-elsewhere" class="eyebrow">Elsewhere</h2>
        <ul role="list" class="links">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
        </ul>
      </Reveal>
    </section>
  </div>

  <CtaBand slot="after" id="about-cta" />
</Page>

<style>
  .about > * + * {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .prose {
    max-width: 68ch;
  }

  .prose p + p {
    margin-top: 1.25rem;
  }

  .bring h2 {
    margin-bottom: 1.5rem;
  }

  .beats {
    display: grid;
    gap: clamp(1.5rem, 1.25rem + 1vw, 2.5rem);
    margin-top: 1.5rem;
  }

  @media (width >= 48rem) {
    .beats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .beats li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Page background is paper (3.22:1) and this is display type well above the
     large-text floor, so bright accent is allowed here. */
  .beat-index {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1;
    color: var(--color-accent);
  }

  .beat-text {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.25;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .bring-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }

  .bring-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    background-color: var(--color-paper-alt);
  }

  .bring-card h3 {
    font-size: var(--text-h3);
    line-height: 1.2;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-top: 0.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
</style>
