---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import Icon from '../ui/Icon.astro';
import { leadServices, buildUpServices, supportingServices, serviceHref } from '../../data/services';
import { serviceIcons } from '../../lib/service-icons';
---

<section class="section section--alt" aria-labelledby="services-title">
  <div class="shell">
    {/* No eyebrow: it read "What I do" above a heading saying the same thing. */}
    <SectionHeader id="services-title" title="What I Do">
      <p>Practical solutions for businesses that want to grow.</p>
    </SectionHeader>

    <Reveal as="ul" stagger class="lead-grid" role="list">
      {
        leadServices.map((service, i) => (
          <li class="card">
            <div class="card-head">
              <span class="card-index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Icon name={serviceIcons[service.slug]} size={28} />
            </div>
            <h3>
              <a href={serviceHref(service.slug)} class="card-link">
                {service.name}
              </a>
            </h3>
            <p>{service.summary}</p>
          </li>
        ))
      }
    </Reveal>

    {/* Build-up sits between the leads and the flat list: it feeds the lead
        offers rather than standing alongside the rest of the capabilities. */}
    <Reveal class="secondary">
      <h3 class="eyebrow">Positioning that ties it together</h3>
      <ul role="list">
        {
          buildUpServices.map((service) => (
            <li>
              <a href={serviceHref(service.slug)}>{service.name}</a>
            </li>
          ))
        }
      </ul>
    </Reveal>

    <Reveal class="secondary">
      <h3 class="eyebrow">Also available</h3>
      <ul role="list">
        {
          supportingServices.map((service) => (
            <li>
              <a href={serviceHref(service.slug)}>{service.name}</a>
            </li>
          ))
        }
      </ul>
    </Reveal>
  </div>
</section>

<style>
  /* Three leads: auto-fit resolves to 1 / 2 / 3 columns with no orphan row, and
     the inner min() stops the track forcing a horizontal scroll under 320px. */
  .lead-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    background-color: var(--color-paper);
    transition: border-color var(--dur-fast) var(--ease-out-expo);
  }

  /* The card's own background is paper, not the band's paper-alt: bright accent
     is 3.22:1 here, which clears the large-text floor for the numeral and the
     3:1 graphics floor for the icon stroke. */
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-accent);
  }

  .card-index {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1;
    color: inherit;
  }

  .card-link {
    color: var(--color-ink);
    text-decoration-line: none;
  }

  /* Whole card is the hit area; the link text stays the accessible name. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--color-ink);
    }
    .card:hover .card-link {
      text-decoration-line: underline;
    }
  }

  .secondary {
    margin-top: 2.5rem;
  }

  .secondary ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-top: 0.5rem;
  }

  .secondary a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
