---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';

const steps = [
  {
    title: 'Understand',
    body: 'I start by understanding your business, audience, goals, and the problem you need solved.',
  },
  {
    title: 'Strategise',
    body: 'I identify the right approach, priorities, and opportunities before jumping into execution.',
  },
  {
    title: 'Execute',
    body: 'I turn the strategy into the actual work, whether that means a campaign, website, content, or digital solution.',
  },
  {
    title: 'Improve',
    body: 'Good work can always get better. I review what is working, identify what isn’t, and make the necessary adjustments.',
  },
];
---

<section class="section section--alt" aria-labelledby="process-title">
  <div class="shell">
    <Reveal>
      <SectionHeader id="process-title" eyebrow="How I work" title="Simple. Clear. Practical." />
    </Reveal>

    <Reveal as="ol" stagger class="steps" role="list">
      {
        steps.map((step, i) => (
          <li>
            <span class="step-number" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>
              <span class="sr-only">Step {i + 1}: </span>
              {step.title}
            </h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </Reveal>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 2.5rem 2rem;
  }

  @media (width >= 40rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Bright accent is ~2.98:1 on the paper-alt band — under even the
     large-text floor — so numerals here use accent-ink. */
  .step-number {
    display: block;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1;
    color: var(--color-accent-ink);
  }

  p {
    margin-top: 0.75rem;
  }
</style>
