---
import Button from '../ui/Button.astro';
import Glow from '../ui/Glow.astro';
import { site } from '../../data/site';
---

{/* Above the fold: no reveal, no animation on anything that carries meaning —
    it would delay LCP. The glow behind it is decorative and aria-hidden, and
    its parallax is a transform on an empty div, so it moves nothing that the
    browser measures for LCP and touches neither the headline nor the subhead. */}
<section class="hero" aria-labelledby="hero-title">
  <Glow opacity={0.1} size="46rem" top="-12rem" right="-14rem" parallax={0.15} />
  <div class="shell hero-inner">
    <p class="eyebrow">{site.role}</p>
    <h1 id="hero-title">{site.name}</h1>
    <p class="hero-line">{site.tagline}</p>
    <p class="hero-sub measure">
      Tell me what your business needs, and I’ll build it with you: a site that converts, video that
      gets watched, ads that bring in the right people. Wherever you’re based.
    </p>
    <div class="hero-actions">
      <Button href="/contact" variant="primary">Start a Project</Button>
      <Button href="/work" variant="secondary">See the work</Button>
    </div>
    {/* TODO(photo): portrait. Use <Image> with loading="eager" and fetchpriority="high". */}
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* The glow is positioned past the right edge; without this it would widen
       the document and put a horizontal scrollbar on every page. */
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 7rem) clamp(3rem, 2rem + 3vw, 5rem);
    background-image: var(--gradient-hero);
  }

  /* Above the decorative layer, which sits at z-index 0. */
  .hero-inner {
    position: relative;
    z-index: 1;
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Wider than the old 24ch: the real positioning line is a full sentence, and
     a narrow measure turned it into a six-line column at display size. */
  .hero-line {
    max-width: 34ch;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1.15;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .hero-sub {
    margin-top: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
