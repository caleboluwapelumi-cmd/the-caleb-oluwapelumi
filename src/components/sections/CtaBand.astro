---
import Button from '../ui/Button.astro';
import Glow from '../ui/Glow.astro';
import Reveal from '../ui/Reveal.astro';

export interface Props {
  /** Unique per page, for aria-labelledby. */
  id?: string;
  title?: string;
  href?: string;
  label?: string;
}

const {
  id = 'cta-title',
  title = 'What are you trying to build?',
  href = '/contact',
  label = 'Start a Conversation',
} = Astro.props;
---

<section class="cta-band" aria-labelledby={id}>
  <Glow
    opacity={0.18}
    size="40rem"
    bottom="-16rem"
    left="-10rem"
    parallax={0.12}
    parallaxStart="top bottom"
  />
  <Reveal class="shell inner">
    <h2 id={id}>{title}</h2>
    <p class="measure">
      <slot>
        Maybe you need a website. Maybe your marketing isn’t working. Maybe you need more leads.
        Maybe you simply have a business problem you haven’t figured out yet. Let’s talk about it.
      </slot>
    </p>
    <div class="actions">
      <Button href={href} variant="primary">{label}</Button>
    </div>
  </Reveal>
</section>

<style>
  /*
   * On ink the bright accent passes at any size, so it can carry small UI here.
   * The gradient only warms the ink; it does not lighten it. Measured against
   * the far stop, and against the glow's peak on top of that stop: paper text
   * 13.84:1, and the accent rule and focus ring 4.30:1 — both still clear of
   * their floors, so nothing on this band needed re-colouring.
   *
   * background-color stays as the paint under the gradient, so a failed image
   * decode leaves dark ink rather than paper text on paper.
   */
  .cta-band {
    position: relative;
    /* The glow is positioned past the left edge — see the note on .hero. */
    overflow: hidden;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    background-color: var(--color-ink);
    background-image: var(--gradient-cta);
    color: var(--color-paper);
  }

  /* Above the decorative layer, which sits at z-index 0. */
  .inner {
    position: relative;
    z-index: 1;
  }

  h2 {
    max-width: 20ch;
    color: var(--color-paper);
  }

  h2::after {
    content: '';
    display: block;
    width: 4rem;
    height: 3px;
    margin-top: 1.5rem;
    background-color: var(--color-accent);
  }

  p {
    margin-top: 1.5rem;
    color: var(--color-paper);
  }

  .actions {
    margin-top: 2rem;
  }

  /* The default primary hover turns ink, which would vanish on this band. */
  @media (hover: hover) {
    .cta-band :global(.btn--primary:hover) {
      background-color: var(--color-paper);
      border-color: var(--color-paper);
      color: var(--color-ink);
    }
  }

  .cta-band :global(:focus-visible) {
    outline-color: var(--color-accent);
  }
</style>
