---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';

// The brief's three-line closer. Three statements, not three claims needing
// proof beside them — so they render as a list, not as titled cards.
const closer = [
  'Strategy that makes sense.',
  'Creative work that communicates.',
  'Digital solutions that work.',
];
---

<section class="section" aria-labelledby="why-title">
  <div class="shell">
    <Reveal>
      <SectionHeader
        id="why-title"
        eyebrow="Why work with me"
        title="You don’t always need more ideas. You need the right execution."
      >
        <p>
          I bring together marketing, sales, creativity, technology, and problem solving to approach
          business challenges from both a strategic and practical perspective.
        </p>
      </SectionHeader>
    </Reveal>

    <Reveal as="ul" stagger class="closer" role="list">
      {closer.map((line) => <li>{line}</li>)}
    </Reveal>
  </div>
</section>

<style>
  .closer {
    display: grid;
    gap: 2rem;
  }

  @media (width >= 48rem) {
    .closer {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  li {
    padding-top: 1.25rem;
    border-top: 3px solid var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.25;
    color: var(--color-ink);
    text-wrap: balance;
  }
</style>
