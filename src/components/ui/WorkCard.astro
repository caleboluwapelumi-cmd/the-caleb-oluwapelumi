---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  href: string;
  title: string;
  summary: string;
  categoryLabel: string;
  cover: ImageMetadata;
  coverAlt: string;
  /** Named client or anonymised descriptor. */
  client?: string;
  year: number;
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  title,
  summary,
  categoryLabel,
  cover,
  coverAlt,
  client,
  year,
  headingLevel: Heading = 'h3',
} = Astro.props;
---

<article class="work-card">
  <div class="media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[400, 640, 960]}
      sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw"
      loading="lazy"
    />
  </div>
  <div class="body">
    <p class="meta">
      <span>{categoryLabel}</span>
      <span aria-hidden="true">·</span>
      <span>{year}</span>
    </p>
    <Heading class="title">
      <a href={href} class="card-link">{title}</a>
    </Heading>
    {client && <p class="client">{client}</p>}
    <p class="summary">{summary}</p>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: var(--color-paper);
    transition: border-color var(--dur-fast) var(--ease-out-expo);
  }

  .media {
    aspect-ratio: 4 / 3;
    background-color: var(--color-paper-alt);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .title {
    font-size: var(--text-h3);
    line-height: 1.25;
  }

  .card-link {
    color: var(--color-ink);
    text-decoration-line: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .client {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-ink);
  }

  @media (hover: hover) {
    .work-card:hover {
      border-color: var(--color-ink);
    }
    .work-card:hover .card-link {
      text-decoration-line: underline;
    }
  }
</style>
