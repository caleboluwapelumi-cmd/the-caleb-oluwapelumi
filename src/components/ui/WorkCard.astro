---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  href: string;
  title: string;
  summary: string;
  categoryLabel: string;
  cover: ImageMetadata;
  coverAlt: string;
  /** Named client or anonymised descriptor. */
  client?: string;
  year: number;
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  title,
  summary,
  categoryLabel,
  cover,
  coverAlt,
  client,
  year,
  headingLevel: Heading = 'h3',
} = Astro.props;
---

<article class="work-card">
  <div class="media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[400, 640, 960]}
      sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw"
      loading="lazy"
    />
  </div>
  <div class="body">
    <p class="meta">
      <span>{categoryLabel}</span>
      <span aria-hidden="true">·</span>
      <span>{year}</span>
    </p>
    <Heading class="title">
      <a href={href} class="card-link">{title}</a>
    </Heading>
    {client && <p class="client">{client}</p>}
    <p class="summary">{summary}</p>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: var(--color-paper);
    transition:
      background-color var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast) var(--ease-out-expo),
      transform var(--dur-base) var(--ease-out-expo);
  }

  .media {
    aspect-ratio: 4 / 3;
    background-color: var(--color-paper-alt);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .title {
    font-size: var(--text-h3);
    line-height: 1.25;
  }

  .card-link {
    color: var(--color-ink);
    text-decoration-line: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .client {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-ink);
  }

  /* :focus-within gives the keyboard the same state the mouse gets, and it is
     outside @media (hover: hover) so it also works on a touch device with a
     keyboard attached. */
  .work-card:focus-within {
    border-color: var(--color-ink);
    transform: translateY(-4px);
  }

  @media (hover: hover) {
    .work-card:hover {
      border-color: var(--color-ink);
      transform: translateY(-4px);
    }
    .work-card:hover .card-link {
      text-decoration-line: underline;
    }
  }

  /* The frost itself. Gated on @supports so a browser without backdrop-filter
     keeps the opaque card rather than showing a semi-transparent one. */
  @supports (backdrop-filter: blur(1px)) {
    .work-card:focus-within {
      background-color: color-mix(
        in srgb,
        var(--color-paper) var(--glass-opacity),
        transparent
      );
      backdrop-filter: blur(var(--glass-blur)) saturate(1.2);
    }

    /* Hover stays gated to real pointers, like every other hover here: a tap
       on a touch screen would otherwise leave the frost stuck on. */
    @media (hover: hover) {
      .work-card:hover {
        background-color: color-mix(
          in srgb,
          var(--color-paper) var(--glass-opacity),
          transparent
        );
        backdrop-filter: blur(var(--glass-blur)) saturate(1.2);
      }
    }
  }

  /* The blur is a still image and can stay; the lift is motion and cannot.
     Last in the file on purpose — it has to win on source order. */
  @media (prefers-reduced-motion: reduce) {
    .work-card:focus-within,
    .work-card:hover {
      transform: none;
    }
  }
</style>
