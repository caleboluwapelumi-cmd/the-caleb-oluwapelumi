---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'hr'> {
  /** Adds a short bright-accent segment at the start of the hairline. */
  accent?: boolean;
}

const { accent = false, class: className, ...rest } = Astro.props;
---

<hr class:list={['rule', accent && 'rule--accent', className]} {...rest} />

<style>
  .rule {
    position: relative;
    height: 1px;
    margin: 0;
    border: 0;
    background-color: var(--color-rule);
    overflow: visible;
  }

  /* Bright accent is fine here: a rule is a graphic, not text. */
  .rule--accent::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: min(4rem, 25%);
    height: 3px;
    background-color: var(--color-accent);
  }
</style>
