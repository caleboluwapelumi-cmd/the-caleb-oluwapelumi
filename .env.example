# Resend API key for sending contact-form email. Server-only — never prefix with PUBLIC_.
RESEND_API_KEY=
# Inbox that receives contact-form enquiries. Server-only.
CONTACT_TO_EMAIL=
# Cloudflare Turnstile site key. Public by design — rendered into the browser widget.
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret for server-side token verification. Server-only.
TURNSTILE_SECRET_KEY=
